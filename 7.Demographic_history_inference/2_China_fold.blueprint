#example blueprint file
#input setting
# id of the population (no white space)
popid: China
# number of sequences
nseq: 128
# total number of observed nucleic sites, including polymorphic and monomorphic
L: 74590
# whethr the SFS is folded (true or false)
whether_folded: true 
# snp frequency spectrum: number of singleton, number of doubleton, etc. (separated by white space)
SFS: 8642.356589147797 2930.361836613018 1586.257483601546 979.6451997613683 677.9509838997787 542.3304710793911 427.8069171139123 343.2801431126584 313.7376267143688 229.7297555158061 215.8224209898617 203.110077519385 170.917948717958 154.9093619558691 159.2451997614682 137.2441264162142 135.902802623744 110.5864042933875 82.34287418007807 88.81025641025759 81.21610017889405 74.61049493142737 74.17769827072081 71.38401908169541 77.01085271317666 64.38366129993811 65.63482409063968 65.65283243887828 62.51878354203652 57.87167561121124 54.17626714370799 56.19141323792459 54.75527728086107 51.01311866428217 48.10137149671835 40.20966010733222 48.29111508646446 55.68527131783155 48.94692903995565 42.53190220632027 40.0238521168734 46.58103756708665 50.29672033392985 39.44066785927274 38.97412045318854 37.07895050685576 36.40417412045217 38.45092426952932 41.57543231962178 38.35575432319771 29.2449612403089 29.8543828264752 32.93070960047738 32.23673225998913 36.90041741204354 40.9895050685733 36.84770423375135 35.17352415026977 40.15980918306472 39.27728085867506 34.42146690518701 29.79105545617174 31.17090041741287 16.22480620155035
#smallest_size_of_SFS_bin_used_for_estimation: 1 # default is 1; to ignore singletons, uncomment this line and change this number to 2
#largest_size_of_SFS_bin_used_for_estimation: 74 # default is nseq/2 for folded SFS
# percentage of sites for training
pct_training: 0.67 
# number of random break points for each try (separated by white space)
nrand: 32	63	94	126
# project directory
project_dir: China_fold 
# directory to the stairway plot files
stairway_plot_dir: stairway_plot_es 
# number of input files to be created for each estimation
ninput: 200 
# the maximum of theta used in the search algorithm, default is 0.2. Increase this value only if seeing confident intervals converged to the same value as a plateau on the plot.
theta_upper_bound: 1 
# this parameter determin the maximum number of iteration of the search algorithm, default is 2000.
dimension_factor: 2000 
#random_seed: 6
#output setting
# assumed mutation rate per site per generation
mu: 5.21e-9
# assumed generation time (in years)
#year_per_generation: 0.067
year_per_generation: 0.083
#plot setting
#title of the plot
#plot_title: Autosome_demographic_inference_mu521_g15
plot_title: Autosome_demographic_inference_mu521_g12_from_0.4_to_600
# Time (1k year) range; format: xmin,xmax; "0,0" for default
#xrange: 0.1,68000
xrange: 0.4,600
# Ne (1k individual) range; format: xmin,xmax; "0,0" for default
yrange: 0,0 
# X axis spacing
xspacing: 4 
# Y axis spacing
yspacing: 2 
# Font size
fontsize: 12 
